/* ---------------------- Base ---------------------- */

QMainWindow {
    background-color: #f5f5f5;
}

QLabel {
    color: black;
}

QLineEdit {
    padding: 4px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

/* ---------------------- Buttons ---------------------- */

QPushButton {
    padding: 8px 14px;
    background-color: #007aff;
    color: white;
    border-radius: 6px;
    font-weight: bold;
    border: none;
}

QPushButton:hover {
    background-color: #005bb5;
}

QPushButton:pressed {
    background-color: #004080;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #666666;
}

/* ---------------------- Left navigation list ---------------------- */

QListWidget {
    color: #000000;
    background-color: #f0f0f0;
    border-right: 1px solid #dddddd;
    font-weight: 500;
}

QListWidget::item {
    padding: 8px 10px;
}

QListWidget::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #e0e0e0;
}

/* ---------------------- Heatmap toolbar panel ---------------------- */

QWidget#heatmapToolbar {
    background-color: #ffffff;
    border-left: 1px solid #dddddd;
    border-top: 1px solid #f3f3f3;  /* light "shadow" at top */
}

/* Section titles (e.g. "Heatmap Settings", "Scatter Settings") */
QLabel[sectionTitle="true"] {
    font-size: 11px;
    font-weight: 600;
    color: #666666;
    margin-top: 8px;
    margin-bottom: 4px;
}

/* Parameter value labels to the right of titles */
QLabel[paramLabel="true"] {
    color: #555555;
    font-weight: 500;
}

/* Optional: extra-bold titles if you mark them */
QLabel[boldTitle="true"] {
    font-weight: bold;
}

/* Full-width separator line in toolbar */
QFrame#sectionSeparator {
    border-top: 1px solid #dddddd;
    margin: 0px;
    background-color: transparent;
}

/* ---------------------- Sliders ---------------------- */

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #dddddd;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #007aff;
    border: none;
    width: 14px;
    margin: -5px 0;  /* lift handle slightly */
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #005bb5;
}

QSlider::handle:horizontal:pressed {
    background: #004080;
}

/* ---------------------- Combobox (collapsed + popup items) ---------------------- */

QComboBox {
    padding: 4px 8px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    color: #000000;
    font-family: "Courier New", "Consolas", "Liberation Mono", "monospace";
}

QComboBox:hover {
    background-color: #f7f7f7;
    border-color: #007aff;
}

QComboBox::drop-down {
    background-color: #f7f7f7;
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
}

/* Items (used both for collapsed text and popup list) */
QComboBox::item {
    color: #000000;               /* normal text */
    background-color: #ffffff;
}

QComboBox::item:selected {
    background-color: #007aff;    /* highlight in popup */
    color: #ffffff;
}

QComboBox::item:hover {
    background-color: #e6f0ff;    /* hover row in popup */
    color: #000000;
}

QCheckBox {
    color: #000000;
}


/* ---------------------- Explanations ---------------------- */
QLabel#FigureCaption {
    font-size: 11px;
    color: #5b6070;
}

QToolButton#InfoButton {
    border: 1px solid #5b6070;
    border-radius: 9px;
    min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px;
    padding: 0; margin: 0;
    font-size: 11px; font-weight: 700;
    color: #5b6070;
    background: transparent;
}
QToolButton#InfoButton:hover, QToolButton#InfoButton:checked {
    color: #4da3ff;
    border-color: #4da3ff;
}

QLabel#PanelTitle {
    font-size: 12px;
    font-weight: 600;
}

QDockWidget#ExplainerDock {
    titlebar-close-icon: none;
}
QDockWidget#ExplainerDock::title {
    background: #e6e8ee;
    color: #3a3f4e;
    padding: 6px 10px;
    font-weight: 600;
}
QDockWidget#ExplainerDock QTextBrowser {
    border: none;
    padding: 6px;
}
