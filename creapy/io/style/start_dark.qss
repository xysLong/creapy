/* Start screen: front page, bundle page and import page. */

QLabel#TitleLabel {
    font-size: 36px;
    font-weight: 800;
    color: #f6f7f9;
}

QLabel#SubtitleLabel {
    font-size: 15px;
    color: #9ba0ab;
}

QLabel#SectionLabel {
    font-size: 12px;
    font-weight: 700;
    color: #6c7180;
}

QLabel#CreditsLabel {
    font-size: 12px;
    color: #6c7180;
}

QPushButton#PrimaryButton, QPushButton#SecondaryAction {
    min-height: 26px;
    padding: 7px 22px;
    font-size: 14px;
    border-radius: 8px;
}

/* ---------- Cards ---------- */

QFrame#StartCard, QFrame#DataCard {
    background-color: #181a20;
    border: 1px solid #2c3039;
    border-radius: 12px;
}

QFrame#DataCard:hover {
    border-color: #4a5063;
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #f6f7f9;
}

QLabel#CardMeta {
    font-size: 12px;
    color: #6c7180;
}

QLabel#ThumbLabel {
    background: transparent;
    border: none;
}

QLabel#SectionTitle {
    font-size: 19px;
    font-weight: 700;
    color: #f6f7f9;
}

QLabel#BodyLabel {
    font-size: 13px;
    color: #b7bcc7;
}

/* ---------- Project tiles ---------- */

QFrame#ProjectTile {
    background-color: #20232b;
    border: 1px solid #2c3039;
    border-radius: 8px;
}

QFrame#ProjectTile:hover {
    background-color: #242830;
    border-color: #5aa9ff;
}

QLabel#TileTitle {
    font-size: 14px;
    font-weight: 700;
    color: #e8e9ed;
}

QLabel#TileFolder {
    font-size: 12px;
    color: #6c7180;
}
